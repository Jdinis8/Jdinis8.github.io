---
layout: null
permalink: /assets/data/design-projects.json
---
{% assign design_projects = site.design_projects | sort: "order" %}
[
{% for project in design_projects %}
  {
    "title": {{ project.title | jsonify }},
    "categories": {{ project.categories | jsonify }},
    "cardSize": {{ project.cardSize | default: "standard" | jsonify }},
    "year": {{ project.year | append: "" | jsonify }},
    "image": {{ project.image | jsonify }},
    "pdf": {{ project.pdf | jsonify }},
    "page": {{ project.page | default: 1 | jsonify }},
    "description": {{ project.description | jsonify }},
    "tools": {{ project.tools | jsonify }},
    "layout": {{ project.image_layout | default: "landscape" | jsonify }},
    "url": {{ project.url | relative_url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]

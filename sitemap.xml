---
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
  </url>
  <url>
    <loc>{{ '/research.html' | absolute_url }}</loc>
  </url>
  <url>
    <loc>{{ '/design.html' | absolute_url }}</loc>
  </url>
  <url>
    <loc>{{ '/history.html' | absolute_url }}</loc>
  </url>
  {% assign history_articles = site.history | sort: "date" | reverse %}
  {% for history_article in history_articles %}
  <url>
    <loc>{{ history_article.url | absolute_url }}</loc>
    <lastmod>{{ history_article.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
</urlset>
